# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/.local-db/
/.local-files/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated local acceptance and architecture artifacts
/output/
/graphify-out/

# Development file store for visit records
/.local-files/

# Browser tests
/.e2e/
/playwright-report/
/test-results/

# Bundled worker and migrate scripts (pnpm build:jobs)
/dist/
/.e2e-*/
/integrations/browser-extension/dist/

# Design-review scratch from the impeccable tool (screenshots, notes); kept locally only.
/.impeccable/
