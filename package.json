  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build --webpack",
    "build:jobs": "node scripts/build-jobs.mjs",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "node --enable-source-maps dist/worker.mjs",
    "worker:local": "KALENDR_WORKER_MODE=local_capture tsx --tsconfig e2e/support/tsconfig.worker.json src/worker/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:extension": "pnpm --filter @kalendr/browser-extension typecheck && pnpm --filter @kalendr/browser-extension build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:jobs && pnpm build:extension",
    "db:seed:demo": "node scripts/seed-demo-bookings.mjs",
    "e2e": "bash scripts/e2e.sh",
    "email:dev": "email dev --dir src/emails --port 3030",
    "knip": "knip",
    "audit:deps": "pnpm audit --audit-level high --prod"
  },
