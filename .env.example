# Local PostgreSQL container. Replace every credential in production.
POSTGRES_DB=kalendr
POSTGRES_USER=kalendr
POSTGRES_PASSWORD=kalendr-local-only-change-me
POSTGRES_PORT=5432

# Required for database-backed operation.
DATABASE_URL=postgresql://kalendr:kalendr-local-only-change-me@localhost:5432/kalendr
DATABASE_POOL_MAX=5

# Generate at least 32 random bytes for every environment.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_ALLOW_SIGNUP=false
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Open public clinic registration only after configuring verification delivery.
KALENDR_ALLOW_CLINIC_REGISTRATION=false

# Sign in with Google and Microsoft for staff (feature 6). Leave blank to hide the buttons.
# Google: OAuth client (Web), redirect URI {BETTER_AUTH_URL}/api/auth/callback/google
# Microsoft: Entra app registration, redirect URI {BETTER_AUTH_URL}/api/auth/callback/microsoft.
# Sign-up on /start uses the same clients with a second redirect URI each:
# {BETTER_AUTH_URL}/api/public/sign-up/callback/google and .../callback/microsoft.
# MICROSOFT_TENANT_ID is "common" (any work or school account) or one directory id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Development only: true shows working Google and Microsoft buttons backed by a built-in
# stand-in (no keys needed). The server refuses to start in production with this on.
KALENDR_DEV_OAUTH=false

# Public origin used in confirmation and manage-booking links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEPLOYMENT_VERSION=local

# Email (Resend). The worker sends appointment emails; the web app sends account emails.
# EMAIL_FROM is the sending address on your verified domain; each business's name is put in front
# of it. Public owner registration requires email delivery. EMAIL_REPLY_TO is used when a business
# has no email of its own. RESEND_WEBHOOK_SECRET (whsec_...) signs /api/webhooks/resend.
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# Online payments (feature 23). Razorpay needs nothing here: each business pastes its own keys in
# Settings, Payments, and they are stored sealed. Stripe Connect needs all three or none: the client id
# (ca_...) from Connect settings, the platform secret key, and the signing secret of a Connect webhook
# pointing at /api/webhooks/stripe (events from connected accounts).
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Push alerts to staff and customers (web push). Set all three or none; without them the bell still works
# and push stays off. Make a key pair once with: pnpm exec web-push generate-vapid-keys
# VAPID_SUBJECT is a contact the push services can reach: mailto:you@example.com or an https address.
# The web app and the worker both read these; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Calendar sync (Google, Outlook, Apple). Empty keys switch that provider off; Apple needs no keys.
# Google: create an OAuth client in Google Cloud (Web application) and enable the Calendar API.
#   Redirect URI: <app address>/api/staff/calendars/callback/google
# Outlook: register an app in Microsoft Entra (Web platform, any account type).
#   Redirect URI: <app address>/api/staff/calendars/callback/microsoft
# CALENDAR_WEBHOOK_TOKEN is a long random secret (24+ characters) both providers echo back with every change
# notification; required when either provider is on. The app address must be public https for push to work;
# without it the worker still reads calendars every 5 minutes.
# CALENDAR_PROVIDER_MODE=fake uses in-memory test calendars and contacts no provider. It is refused unless
# BETTER_AUTH_URL is localhost.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
CALENDAR_WEBHOOK_TOKEN=
CALENDAR_PROVIDER_MODE=live
# SMS: msg91 for India (DLT-registered), twilio elsewhere.
SMS_PROVIDER=
SMS_API_KEY=
# WhatsApp Cloud API (Meta). The verify token is any long random string you also enter in Meta's
# webhook settings; the app secret signs every webhook. WHATSAPP_API_URL is for local capture only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_URL=
# MSG91: MSG91_SENDER_ID is the DLT-approved header. MSG91_WEBHOOK_TOKEN goes in the delivery-report
# URL you give MSG91 (/api/webhooks/msg91/<token>). Twilio signs its callbacks with the auth token.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WEBHOOK_TOKEN=
MSG91_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_API_URL=

# Video visits (feature 19). VIDEO_PROVIDER=daily needs DAILY_API_KEY and DAILY_DOMAIN (the "name" in
# name.daily.co). VIDEO_PROVIDER=none turns video off. Blank is local test mode in development (rooms are
# made in memory and the call screen shows your own camera only, so nothing leaves this machine) and off in
# production. VIDEO_PROVIDER=test forces test mode; production refuses it unless KALENDR_ALLOW_TEST_VIDEO=true
# (browser tests only).
VIDEO_PROVIDER=
DAILY_API_KEY=
DAILY_DOMAIN=

# Visit records. Required in production, or records stay off.
# The original server-wide key (32 random bytes in base64). Keep it: records written before
# per-business keys (key version 0) still open with it until the re-encryption job moves them.
KALENDR_RECORDS_KEY=
# Per-business data keys are wrapped by a master key: "kms" (AWS KMS) in production,
# "local" for development and tests. docs/SECURITY.md explains rotation.
KALENDR_KEY_PROVIDER=local
# local only: 32 random bytes in base64 (openssl rand -base64 32). Never reuse a production value.
KALENDR_LOCAL_MASTER_KEY=
# kms only: the key's ARN or alias, and its region.
KMS_KEY_ID=
KMS_REGION=

# Where encrypted files and pictures go: "disk" (development) or "s3" (production, or MinIO locally).
KALENDR_FILE_STORE=disk
# disk only: private, durable, backed-up directory. Defaults to .local-files outside production.
KALENDR_FILE_STORE_DIR=
# s3 only. For MinIO from compose.yaml: S3_ENDPOINT=http://127.0.0.1:9000, S3_FORCE_PATH_STYLE=true.
# Set the bucket up once with: node scripts/s3-bucket.mjs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Virus checks for uploads (ClamAV clamd). Required in production: without it, uploads are refused.
# Leave empty in development to skip checks. compose.yaml runs one on 127.0.0.1:3310.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Websites that may always frame public booking, for every business (Kalendr's own demo pages, for example).
# Production values must be exact HTTPS origins. Each business adds its own sites in Settings; those are added to this list.
KALENDR_BOOKING_FRAME_ANCESTORS=http://localhost:3000

# Own web address (feature 13). Owners point a CNAME at KALENDR_CNAME_TARGET, a host that reaches this app and issues
# certificates only after asking /api/internal/domain-check. Without a target the screen explains that the feature is not set up,
# and every host is served as Kalendr's own. With a target set, any host that is not Kalendr's own (see KALENDR_OWN_HOSTS)
# and is not a business's live address gets a 404, except /api/health and /api/ready, which answer on any host.
KALENDR_CNAME_TARGET=
# Extra hosts that are Kalendr's own, comma separated (the host of NEXT_PUBLIC_APP_URL and BETTER_AUTH_URL, KALENDR_CNAME_TARGET,
# localhost and 127.0.0.1 are always own hosts). REQUIRED once a CNAME target is set if staff or customers reach the app by any
# other name (a second domain, an internal service name): list every one, or it is refused as an unknown address.
KALENDR_OWN_HOSTS=
# Optional. When set, /api/internal/domain-check needs ?token=<this value>, so only your certificate host can ask. Generate with: openssl rand -hex 32
KALENDR_DOMAIN_CHECK_TOKEN=

# Request limits count per client IP address. Set this to how many proxies in front of the app
# append to X-Forwarded-For (1 behind a single load balancer or CDN). Required in production;
# leave empty locally, where the socket address is used.
TRUSTED_PROXY_HOPS=

# Search and discovery (feature 29): how many seconds each web process keeps the sitemap files and the /explore filters before
# asking the database again. Empty means 600 (10 minutes). 0 turns it off, which the browser tests use.
KALENDR_DISCOVERY_CACHE_SECONDS=

# Bot check (Cloudflare Turnstile) on sign-up, customer code requests and public booking, shown
# only after a second attempt from the same network. Off unless both are set. For local testing
# use Cloudflare's published test keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (always passes).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Keep false/absent in production. Development without DATABASE_URL previews automatically.
KALENDR_PREVIEW_MODE=false

# Logs (pino). One of fatal, error, warn, info, debug, trace, silent. Personal data is always redacted.
LOG_LEVEL=info

# Error reporting (Sentry). Off unless a DSN is set. Events are scrubbed of personal data first.
SENTRY_DSN=
# Browser error reporting; inlined at build time. Leave empty to keep browser reporting off.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Build-time only, for uploading source maps. Not read at runtime.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Tracing (OpenTelemetry over OTLP). Off unless an endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kalendr-web

# Send endpoint for email. Defaults to Resend; browser tests and local runs point it at the local
# capture server (node e2e/support/capture-server.mjs, http://127.0.0.1:3199/emails). In
# local_capture mode the worker sends email only when this is a loopback address.
EMAIL_API_URL=

# Outbox worker (pnpm worker). local_capture (the default, and the only mode tests use) records each
# message in the notifications table and sends nothing; it refuses production and non-loopback
# databases. production hands messages to the provider adapters; a channel with no adapter goes to
# dead letter as provider_not_configured.
KALENDR_WORKER_MODE=local_capture
# The worker's own connection, as the kalendr_worker role (no BYPASSRLS). Required.
WORKER_DATABASE_URL=
# How many outbox rows one worker handles at once, 1 to 32. Default 4.
WORKER_CONCURRENCY=4

# Release step (node dist/migrate.mjs). The schema owner's connection; used only to migrate, never by
# the web app or worker. KALENDR_RUNTIME_ROLE is the non-owner role the app connects as.
DATABASE_OWNER_URL=
KALENDR_RUNTIME_ROLE=kalendr_app

# compose.yaml "app" profile only: the connections the app and worker containers use, and the host port.
KALENDR_APP_DATABASE_URL=
KALENDR_WORKER_DATABASE_URL=
KALENDR_APP_PORT=3000

# Platform admin console (feature 15). Operators are made with scripts/make-platform-admin.mjs. Both are optional
# and stack with the second-factor rule, which has no switch. Anyone outside them gets a plain 404.
# Serve /admin and /api/admin only on this Host (for example admin.kalendr.example). Empty means any host.
KALENDR_ADMIN_HOST=
# Comma-separated IP addresses allowed to open the console. Read from X-Forwarded-For using TRUSTED_PROXY_HOPS. Empty means any address.
KALENDR_ADMIN_IP_ALLOWLIST=

# Subscription billing (feature 14): Kalendr's own plans, paid by businesses. Separate from customer payments.
# Razorpay (India: UPI Autopay or card). Create a Razorpay account with Subscriptions and UPI Autopay enabled, then
# add a webhook to /api/webhooks/billing/razorpay for subscription.* and payment.failed with the secret below.
# Use test-mode keys (rzp_test_...) until you go live. There is no default, so checkout stays off until these are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids that `node scripts/billing-sync-plans.mjs razorpay` prints. They can also live in the plans table (razorpay_plan_id).
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_SCALE=
# Stripe (everywhere else). Webhook endpoint /api/webhooks/billing/stripe for checkout.session.completed, customer.subscription.*,
# invoice.paid and invoice.payment_failed. Use sk_test_ keys until you go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids that `node scripts/billing-sync-plans.mjs stripe` prints (or plans.stripe_price_id).
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=
# Kalendr's own GSTIN, printed on invoices to businesses (18% GST on rupee charges). Leave empty until registered.
KALENDR_GSTIN=

# AI booking assistant (feature 30). With no key the assistant stays off and visitors get the normal booking link.
# ASSISTANT_PROVIDER_MODE=fake runs a scripted model with no network, for development and browser tests only
# (refused unless BETTER_AUTH_URL is on this machine).
ANTHROPIC_API_KEY=
ASSISTANT_PROVIDER_MODE=
ASSISTANT_MODEL=
ASSISTANT_STAFF_MODEL=
ASSISTANT_MONTHLY_TOKEN_CAP=
# Enterprise and teams (feature 53) needs no new environment variables. Company sign-in addresses are built from
# BETTER_AUTH_URL (or NEXT_PUBLIC_APP_URL), so those must be the public https address in production: identity providers are
# told to reply there. Per-business identity provider details are entered on the Sign-in screen, not here.
